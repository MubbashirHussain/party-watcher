<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Room · Party Watch</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; }
    video { width: 100%; max-height: 70vh; background: #000; }
    .badge { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.8rem; }
    .badge.admin { background: #d4edda; color: #155724; }
    .badge.viewer { background: #e2e3e5; color: #383d41; }
    .room-url { display: flex; gap: 0.5rem; align-items: center; }
    .room-url code { background: #f1f3f4; padding: 0.4rem 0.6rem; border-radius: 4px; flex: 1; overflow-wrap: anywhere; }
    .movie-id { color: #666; font-size: 0.9rem; }
    .copy-status { color: #155724; margin-left: 0.5rem; }
  </style>
</head>
<body>
  <p><a href="/">← All movies</a></p>
  <h1>Watch Room</h1>

  <% if (isAdmin) { %>
    <span class="badge admin">You are the admin</span>
  <% } else { %>
    <span class="badge viewer">You are a viewer</span>
  <% } %>

  <p class="movie-id">Movie: <code><%= movieId %></code></p>

  <video id="player" controls autoplay src="/movie/<%= movieId %>"></video>

  <h2>Share this room</h2>
  <div class="room-url">
    <code id="roomUrl"><%= roomUrl %></code>
    <button type="button" id="copyButton">Copy</button>
    <span class="copy-status" id="copyStatus" hidden>Copied!</span>
  </div>

  <script>
    const roomUrl = document.getElementById('roomUrl');
    const copyButton = document.getElementById('copyButton');
    const copyStatus = document.getElementById('copyStatus');

    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(roomUrl.textContent.trim());
        copyStatus.hidden = false;
        setTimeout(() => { copyStatus.hidden = true; }, 1500);
      } catch {
        // Clipboard API unavailable (e.g. non-secure context); fall back to select + prompt.
        roomUrl.focus();
        roomUrl.select();
        document.execCommand('copy');
      }
    });
  </script>
</body>
</html>
