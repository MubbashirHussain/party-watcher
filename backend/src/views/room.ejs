<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= movieTitle %> · Party Watch</title>
  <link rel="stylesheet" href="/static/css/app.css" />
</head>
<body>
  <div class="room-page">
    <div class="room-stage" id="roomStage">
      <video id="player" controls autoplay src="/movie/<%= movieId %>"></video>

      <div class="room-overlay" id="roomOverlay">
        <div class="overlay-top">
          <span class="movie-title"><%= movieTitle %></span>
          <% if (isAdmin) { %>
            <span class="badge">Host</span>
          <% } else { %>
            <span class="badge">Viewer</span>
          <% } %>
        </div>
        <div class="overlay-meta"><%= movieYear %> · <%= movieDuration %></div>
        <div class="room-info">Room: <code><%= roomId %></code></div>
        <div class="share-row">
          <code id="roomUrl"><%= roomUrl %></code>
          <button type="button" id="copyButton">Copy</button>
          <span class="copy-status" id="copyStatus" hidden>Copied!</span>
        </div>
      </div>

      <a class="room-back" href="/">← All movies</a>
    </div>
  </div>

  <script>
    const stage = document.getElementById('roomStage');
    const copyButton = document.getElementById('copyButton');
    const copyStatus = document.getElementById('copyStatus');
    const roomUrl = document.getElementById('roomUrl');

    let hideTimer = null;

    function showOverlay() {
      stage.classList.add('overlay-visible');
      clearTimeout(hideTimer);
      hideTimer = setTimeout(hideOverlay, 2500);
    }

    function hideOverlay() {
      stage.classList.remove('overlay-visible');
    }

    // Desktop: mouse movement over the room shows the overlay.
    stage.addEventListener('mousemove', showOverlay);

    // Mobile: tapping the video reveals the overlay.
    stage.addEventListener('touchstart', showOverlay, { passive: true });

    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(roomUrl.textContent.trim());
        copyStatus.hidden = false;
        setTimeout(() => { copyStatus.hidden = true; }, 1500);
      } catch {
        // Clipboard API unavailable (e.g. non-secure context); fall back to select.
        roomUrl.focus();
        roomUrl.select();
        document.execCommand('copy');
        copyStatus.hidden = false;
        setTimeout(() => { copyStatus.hidden = true; }, 1500);
      }
    });
  </script>
</body>
</html>
