<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof movieTitle !== 'undefined' ? movieTitle : 'Watch Room' %> · Party Watch</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        darkBg: '#09090b',
                        cardBg: '#121217',
                        accent: '#e50914',
                        accentHover: '#f40612',
                    }
                }
            }
        }
    </script>
    <style>
        video::-webkit-media-controls { display: none !important; }
        video::-webkit-media-controls-enclosure { display: none !important; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-darkBg text-zinc-100 font-sans antialiased h-screen overflow-hidden flex flex-col selection:bg-accent selection:text-white">

    <!-- 1. Private Room Password Lock Screen -->
    <% if (typeof needsPassword !== 'undefined' && needsPassword) { %>
        <div class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4">
            <div class="bg-cardBg border border-zinc-800/80 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl shadow-black relative overflow-hidden">
                <div class="absolute -top-24 -left-24 w-48 h-48 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>
                
                <div class="w-12 h-12 rounded-2xl bg-accent/20 border border-accent/40 flex items-center justify-center text-accent mb-4 shadow-lg shadow-accent/10">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                </div>
                <h2 class="text-xl font-bold text-white mb-1 tracking-tight">Private Screening Room</h2>
                <p class="text-sm text-zinc-400 mb-6">Enter the room password to join <span class="text-zinc-200 font-medium"><%= typeof movieTitle !== 'undefined' ? movieTitle : 'this session' %></span>.</p>
                
                <% if (typeof passwordError !== 'undefined' && passwordError) { %>
                    <div class="mb-4 px-4 py-3 rounded-xl bg-accent/10 border border-accent/40 text-xs text-accent font-medium">
                        Incorrect password. Please ask the host for the correct code.
                    </div>
                <% } %>

                <form method="post" action="/room/<%= roomId %>/password" class="space-y-4">
                    <div>
                        <input
                            type="password"
                            name="password"
                            placeholder="Enter room password..."
                            maxlength="50"
                            autocomplete="current-password"
                            required
                            autofocus
                            class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all shadow-inner"
                        />
                    </div>
                    <button type="submit" class="w-full py-3 bg-accent hover:bg-accentHover text-white font-semibold text-sm rounded-xl shadow-lg shadow-accent/25 transition-all cursor-pointer">
                        Unlock Room →
                    </button>
                </form>
                <div class="mt-6 pt-4 border-t border-zinc-800/80 text-center">
                    <a href="/" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors">← Back to Home</a>
                </div>
            </div>
        </div>
    <% } 
       /* 2. Display Name Prompt Screen if unlocked or public but user name not set */
       else if (typeof userName === 'undefined' || !userName) { %>
        <div class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4">
            <div class="bg-cardBg border border-zinc-800/80 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl shadow-black relative overflow-hidden">
                <div class="absolute -top-24 -right-24 w-48 h-48 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="w-12 h-12 rounded-2xl bg-accent flex items-center justify-center text-white font-bold text-lg mb-4 shadow-lg shadow-accent/30">
                    PW
                </div>
                <h2 class="text-xl font-bold text-white mb-1 tracking-tight">Join Screening Room</h2>
                <p class="text-sm text-zinc-400 mb-6">Enter your display name to join friends watching <span class="text-zinc-200 font-medium"><%= typeof movieTitle !== 'undefined' ? movieTitle : 'this movie' %></span>.</p>
                
                <form method="post" action="/room/<%= roomId %>/join" class="space-y-4">
                    <div>
                        <input
                            type="text"
                            name="name"
                            placeholder="Your display name..."
                            maxlength="30"
                            autocomplete="off"
                            required
                            autofocus
                            class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all shadow-inner"
                        />
                    </div>
                    <button type="submit" class="w-full py-3 bg-accent hover:bg-accentHover text-white font-semibold text-sm rounded-xl shadow-lg shadow-accent/25 transition-all cursor-pointer">
                        Enter Room →
                    </button>
                </form>
                <div class="mt-6 pt-4 border-t border-zinc-800/80 text-center">
                    <a href="/" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors">← Back to Home</a>
                </div>
            </div>
        </div>
    <% } 
       /* 3. Main Screening Room Player Interface */
       else { %>

    <div id="playerContainer" class="relative w-full h-full flex items-center justify-center bg-black overflow-hidden group select-none cursor-default">
        
        <video 
            id="videoElement" 
            class="w-full h-full object-contain pointer-events-none"
            src="/movie/<%= movieId %>"
            preload="metadata"
            playsinline
            poster="/movie/<%= movieId %>/thumbnail"
        ></video>

        <!-- <div id="videoMockOverlay" class="absolute inset-0 bg-zinc-950 flex flex-col items-center justify-center text-center p-6 hidden">
            <div class="w-20 h-20 rounded-3xl bg-accent/20 border border-accent/40 flex items-center justify-center text-accent mb-4 shadow-xl shadow-accent/10">
                <svg class="w-10 h-10 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <h2 class="text-xl font-bold text-white mb-1"><%= typeof movieTitle !== 'undefined' ? movieTitle : 'Movie' %></h2>
            <p class="text-sm text-zinc-400">Cinematic Watch Room Active</p>
        </div> -->

        <div id="centerPlayIndicator" class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-300">
            <div class="w-20 h-20 rounded-full bg-black/60 backdrop-blur-md border border-white/10 flex items-center justify-center text-white text-3xl shadow-2xl">
                <span id="centerIcon">▶</span>
            </div>
        </div>

        <div id="topOverlay" class="absolute top-0 inset-x-0 p-4 sm:p-6 bg-gradient-to-b from-black/90 via-black/50 to-transparent transition-opacity duration-300 flex items-center justify-between z-20">
            <div class="flex items-center space-x-3 sm:space-x-4">
                <a href="/" class="p-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white backdrop-blur-md border border-white/10 transition-all shadow-lg flex items-center justify-center group">
                    <svg class="w-5 h-5 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
                </a>
                <div>
                    <div class="flex items-center space-x-2">
                        <h1 class="text-base sm:text-lg font-bold text-white tracking-tight drop-shadow-md line-clamp-1"><%= typeof movieTitle !== 'undefined' ? movieTitle : 'Movie' %></h1>
                        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                            <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-accent text-white rounded shadow-sm">Host</span>
                        <% } else { %>
                            <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-zinc-800/80 border border-white/10 text-zinc-300 rounded backdrop-blur-md">Viewer</span>
                        <% } %>
                    </div>
                    <div class="flex items-center space-x-2 text-xs text-zinc-400 font-medium">
                        <span><%= typeof movieYear !== 'undefined' ? movieYear : '2026' %></span>
                        <span>•</span>
                        <span><%= typeof movieDuration !== 'undefined' ? movieDuration : '2h 15m' %></span>
                        <span>•</span>
                        <span class="text-zinc-300 font-mono">Room: <%= roomId %></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center space-x-3">
                <div class="hidden sm:flex items-center space-x-2 px-3.5 py-2 rounded-xl bg-black/60 backdrop-blur-md border border-white/10 text-xs text-zinc-300 shadow-lg">
                    <div class="flex -space-x-1.5 overflow-hidden">
                        <div class="inline-block w-5 h-5 rounded-full ring-2 ring-black bg-accent text-[10px] font-bold flex items-center justify-center text-white">
                            <%= typeof userName !== 'undefined' && userName ? userName.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <% if (typeof roomUsers !== 'undefined' && roomUsers.length > 0) { %>
                            <% roomUsers.slice(0, 2).forEach(u => { %>
                                <div class="inline-block w-5 h-5 rounded-full ring-2 ring-black bg-zinc-700 text-[10px] font-bold flex items-center justify-center text-white"><%= u.charAt(0).toUpperCase() %></div>
                            <% }); %>
                        <% } %>
                    </div>
                    <span id="watchCountEl" class="font-medium pl-1"><%= (typeof roomUsers !== 'undefined' && roomUsers.length ? roomUsers.length : 1) %> watching</span>
                </div>

                <button onclick="openInviteModal()" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold backdrop-blur-md border border-white/10 transition-all shadow-lg flex items-center space-x-2 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                    <span class="hidden md:inline">Invite Friends</span>
                </button>
            </div>
        </div>

        <div id="bottomOverlay" class="absolute bottom-0 inset-x-0 p-4 sm:p-6 bg-gradient-to-t from-black/95 via-black/70 to-transparent transition-opacity duration-300 z-20 flex flex-col space-y-3">
            <div class="relative group/timeline flex items-center cursor-pointer w-full h-3">
                <div id="timelineBar" class="relative w-full h-1.5 bg-white/20 rounded-full overflow-hidden transition-all group-hover/timeline:h-2.5">
                    <div id="bufferProgress" class="absolute top-0 left-0 h-full bg-white/30 w-1/2 rounded-full"></div>
                    <div id="playedProgress" class="absolute top-0 left-0 h-full bg-accent w-0 rounded-full transition-all duration-75"></div>
                </div>
                <div id="timelineThumb" class="absolute left-0 w-3.5 h-3.5 bg-white rounded-full shadow-lg transform -translate-x-1/2 opacity-0 group-hover/timeline:opacity-100 transition-opacity pointer-events-none"></div>
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3 sm:space-x-4">
                    <button id="playPauseBtn" class="p-2 rounded-xl bg-white/10 hover:bg-accent text-white transition-all shadow-md flex items-center justify-center cursor-pointer <%= !isAdmin ? 'opacity-40 pointer-events-none' : '' %>">
                        <svg id="playIcon" class="w-6 h-6 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                        <svg id="pauseIcon" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                    </button>

                    <button onclick="skipTime(-10)" class="hidden sm:flex p-2 text-zinc-300 hover:text-white transition-colors <%= !isAdmin ? 'opacity-40 pointer-events-none' : '' %>" title="Rewind 10s">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0019 16V8a1 1 0 00-1.6-.8l-5.334 4zM4.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0011 16V8a1 1 0 00-1.6-.8l-5.334 4z"/></svg>
                    </button>
                    <button onclick="skipTime(10)" class="hidden sm:flex p-2 text-zinc-300 hover:text-white transition-colors <%= !isAdmin ? 'opacity-40 pointer-events-none' : '' %>" title="Forward 10s">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.934 12.8a1 1 0 000-1.6l-5.334-4A1 1 0 005 8v8a1 1 0 001.6.8l5.334-4zM19.934 12.8a1 1 0 000-1.6l-5.334-4A1 1 0 0013 8v8a1 1 0 001.6.8l5.334-4z"/></svg>
                    </button>

                    <div class="flex items-center space-x-2 group/vol">
                        <button id="muteBtn" class="p-2 text-zinc-300 hover:text-white transition-colors">
                            <svg id="volumeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                        </button>
                        <input id="volumeSlider" type="range" min="0" max="1" step="0.05" value="1" class="w-16 sm:w-20 accent-accent cursor-pointer h-1.5 bg-white/20 rounded-lg">
                    </div>

                    <div class="text-xs font-medium text-zinc-300 tabular-nums">
                        <span id="currentTime">0:00</span> / <span id="durationTime">0:00</span>
                    </div>
                </div>

                <div class="flex items-center space-x-2 sm:space-x-3">
                    <div class="relative">
                        <button id="speedBtn" onclick="toggleSpeedMenu()" class="px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-semibold text-zinc-200 transition-colors">1x</button>
                        <div id="speedMenu" class="hidden absolute bottom-full right-0 mb-2 w-28 bg-cardBg border border-zinc-800 rounded-xl shadow-2xl overflow-hidden py-1 z-30">
                            <button onclick="setSpeed(0.5)" class="w-full px-3 py-1.5 text-left text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white">0.5x</button>
                            <button onclick="setSpeed(1)" class="w-full px-3 py-1.5 text-left text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white font-bold text-accent">Normal (1x)</button>
                            <button onclick="setSpeed(1.25)" class="w-full px-3 py-1.5 text-left text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white">1.25x</button>
                            <button onclick="setSpeed(1.5)" class="w-full px-3 py-1.5 text-left text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white">1.5x</button>
                            <button onclick="setSpeed(2)" class="w-full px-3 py-1.5 text-left text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white">2.0x</button>
                        </div>
                    </div>

                    <div class="relative <%= !isAdmin ? 'hidden' : '' %>">
                        <button onclick="toggleQualityMenu()" class="px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-semibold text-zinc-200 transition-colors flex items-center space-x-1">
                            <span id="currentQuality">1080p</span>
                        </button>
                        <div id="qualityMenu" class="hidden absolute bottom-full right-0 mb-2 w-32 bg-cardBg border border-zinc-800 rounded-xl shadow-2xl overflow-hidden py-1 z-30">
                            <div class="px-3 py-1 text-[10px] font-bold uppercase text-zinc-500 tracking-wider">Quality</div>
                            <button onclick="setQuality('Auto')" class="w-full px-3 py-1.5 text-left text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white font-medium">Auto</button>
                            <button onclick="setQuality('1080p')" class="w-full px-3 py-1.5 text-left text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white font-medium text-accent">1080p HD</button>
                            <button onclick="setQuality('720p')" class="w-full px-3 py-1.5 text-left text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white font-medium">720p</button>
                            <button onclick="setQuality('480p')" class="w-full px-3 py-1.5 text-left text-xs text-zinc-300 hover:bg-zinc-800 hover:text-white font-medium">480p</button>
                        </div>
                    </div>

                    <button id="fullscreenBtn" class="p-2 rounded-xl bg-white/10 hover:bg-white/20 text-white transition-all shadow-md cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5v4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast notification container -->
    <div id="toastContainer" class="fixed top-6 right-6 z-50 flex flex-col space-y-2 items-end pointer-events-none"></div>

    <div id="inviteModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-cardBg border border-zinc-800/80 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl shadow-black relative">
            <button onclick="closeInviteModal()" class="absolute top-6 right-6 text-zinc-400 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <div class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-white mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2 tracking-tight">Invite Friends</h3>
            <p class="text-sm text-zinc-400 mb-6">Share this room link with your friends to watch together in real-time sync.</p>
            
            <div class="flex items-center space-x-2 bg-zinc-900 border border-zinc-800 rounded-xl p-2 mb-4">
                <input id="roomUrlInput" type="text" readonly value="<%= typeof roomUrl !== 'undefined' ? roomUrl : 'https://partywatch.app/room/' + roomId %>" class="w-full bg-transparent text-xs text-zinc-300 px-2 focus:outline-none font-mono" />
                <button onclick="copyInviteLink()" class="px-4 py-2 bg-accent hover:bg-accentHover text-white text-xs font-semibold rounded-lg shadow transition-all whitespace-nowrap">Copy</button>
            </div>
            <p id="copyNotification" class="text-xs text-emerald-400 font-medium hidden">✓ Invite link copied to clipboard!</p>
        </div>
    </div>

    <script>
        const video = document.getElementById('videoElement');
        const playerContainer = document.getElementById('playerContainer');
        const topOverlay = document.getElementById('topOverlay');
        const bottomOverlay = document.getElementById('bottomOverlay');
        const playPauseBtn = document.getElementById('playPauseBtn');
        const playIcon = document.getElementById('playIcon');
        const pauseIcon = document.getElementById('pauseIcon');
        const currentTimeEl = document.getElementById('currentTime');
        const durationTimeEl = document.getElementById('durationTime');
        const timelineBar = document.getElementById('timelineBar');
        const playedProgress = document.getElementById('playedProgress');
        const timelineThumb = document.getElementById('timelineThumb');
        const volumeSlider = document.getElementById('volumeSlider');
        const muteBtn = document.getElementById('muteBtn');
        const fullscreenBtn = document.getElementById('fullscreenBtn');
        const centerPlayIndicator = document.getElementById('centerPlayIndicator');
        const centerIcon = document.getElementById('centerIcon');
        const videoMockOverlay = document.getElementById('videoMockOverlay');

        // Sync identity injected by the server. The WebSocket identifies this
        // client with roomId + userId; the server derives host status from
        // userId === room.adminId and never trusts a client-sent isAdmin.
        const IS_ADMIN = <%= isAdmin %>;
        const ROOM_ID = "<%= roomId %>";
        const USER_ID = "<%= userId %>";

        let hideTimeout = null;
        let pendingSeek = null;
        let ws = null;
        let wsConnected = false;
        let reconnectTimer = null;
        let reconnectAttempts = 0;
        let statePollTimer = null;
        // Set when the browser blocks play() after a reload (autoplay policy
        // requires a user gesture on the fresh page). The next click on the
        // player resumes playback instead of showing the error overlay.
        let autoplayBlocked = false;

        // Plays the video, distinguishing a real failure (missing/unplayable
        // file → mock overlay) from an autoplay block after a reload
        // (NotAllowedError → static ▶ prompt; the next click resumes).
        function requestPlay() {
            video.play().then(() => {
                autoplayBlocked = false;
                centerPlayIndicator.style.opacity = '0';
            }).catch((err) => {
                if (err && err.name === 'NotAllowedError') {
                    autoplayBlocked = true;
                    centerIcon.textContent = '▶';
                    centerPlayIndicator.style.opacity = '1';
                } else {
                    videoMockOverlay.classList.remove('hidden');
                }
            });
        }

        video.addEventListener('error', () => {
            video.style.display = 'none';
            videoMockOverlay.classList.remove('hidden');
        });

        function formatTime(seconds) {
            if (isNaN(seconds)) return "0:00";
            const m = Math.floor(seconds / 60);
            const s = Math.floor(seconds % 60);
            return `${m}:${s < 10 ? '0' : ''}${s}`;
        }

        function togglePlay() {
            // Viewers never control playback; only the host's actions are sent.
            if (!IS_ADMIN) return;
            if (video.paused) {
                requestPlay();
                sendPlaybackEvent({ type: 'play', timeline: video.currentTime });
            } else {
                video.pause();
                sendPlaybackEvent({ type: 'pause', timeline: video.currentTime });
            }
            updatePlayButtons();
            triggerCenterAnimation();
        }

        function updatePlayButtons() {
            if (video.paused) {
                playIcon.classList.remove('hidden');
                pauseIcon.classList.add('hidden');
                centerIcon.textContent = '⏸';
            } else {
                playIcon.classList.add('hidden');
                pauseIcon.classList.remove('hidden');
                centerIcon.textContent = '▶';
            }
        }

        playPauseBtn.addEventListener('click', togglePlay);
        playerContainer.addEventListener('click', (e) => {
            if (e.target.closest('#topOverlay') || e.target.closest('#bottomOverlay')) return;
            if (autoplayBlocked) {
                // The browser blocked autoplay after a reload — this click is
                // the gesture that unlocks playback. Resume locally without
                // toggling or broadcasting; the room state already says
                // "playing". This is also the viewer's only way to resume,
                // since viewers cannot toggle playback.
                requestPlay();
                updatePlayButtons();
                return;
            }
            togglePlay();
        });

        function triggerCenterAnimation() {
            centerPlayIndicator.style.opacity = '1';
            setTimeout(() => {
                // Keep the ▶ prompt up while autoplay is still blocked.
                centerPlayIndicator.style.opacity = autoplayBlocked ? '1' : '0';
            }, 600);
        }

        video.addEventListener('timeupdate', () => {
            if (!video.duration) return;
            const percent = (video.currentTime / video.duration) * 100;
            playedProgress.style.width = `${percent}%`;
            timelineThumb.style.left = `${percent}%`;
            currentTimeEl.textContent = formatTime(video.currentTime);
        });

        video.addEventListener('loadedmetadata', () => {
            durationTimeEl.textContent = formatTime(video.duration);
        });

        timelineBar.addEventListener('click', (e) => {
            if (!IS_ADMIN) return;
            const rect = timelineBar.getBoundingClientRect();
            const pos = (e.clientX - rect.left) / rect.width;
            if (video.duration) {
                video.currentTime = pos * video.duration;
                sendPlaybackEvent({ type: 'seek', timeline: video.currentTime });
            }
        });

        function skipTime(sec) {
            if (!IS_ADMIN) return;
            if (video.duration) {
                video.currentTime = Math.min(Math.max(video.currentTime + sec, 0), video.duration);
                sendPlaybackEvent({ type: 'seek', timeline: video.currentTime });
            }
        }

        volumeSlider.addEventListener('input', (e) => {
            video.volume = e.target.value;
            video.muted = (video.volume === 0);
        });

        muteBtn.addEventListener('click', () => {
            video.muted = !video.muted;
            volumeSlider.value = video.muted ? 0 : video.volume;
        });

        fullscreenBtn.addEventListener('click', () => {
            if (!document.fullscreenElement) {
                playerContainer.requestFullscreen().catch(() => {});
            } else {
                document.exitFullscreen().catch(() => {});
            }
        });

        function toggleSpeedMenu() {
            // Playback speed must match the host; viewers cannot change it.
            if (!IS_ADMIN) return;
            document.getElementById('speedMenu').classList.toggle('hidden');
            document.getElementById('qualityMenu').classList.add('hidden');
        }

        function setSpeed(rate) {
            if (!IS_ADMIN) return;
            video.playbackRate = rate;
            document.getElementById('speedBtn').textContent = `${rate}x`;
            document.getElementById('speedMenu').classList.add('hidden');
            // Broadcast the new rate with the host's current position so
            // viewers snap to the same timeline at the same moment.
            sendPlaybackEvent({ type: 'speed', speed: rate, timeline: video.currentTime });
        }

        function toggleQualityMenu() {
            document.getElementById('qualityMenu').classList.toggle('hidden');
            document.getElementById('speedMenu').classList.add('hidden');
        }

        function setQuality(qual) {
            document.getElementById('currentQuality').textContent = qual;
            document.getElementById('qualityMenu').classList.add('hidden');
            if (IS_ADMIN) {
                sendPlaybackEvent({ type: 'quality', quality: qual });
            }
        }

        // Playback speed is synced from the host — viewers see the host's
        // rate and cannot change it.

        function showToast(message) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className =
                'bg-zinc-900/95 backdrop-blur-md border border-zinc-700/80 rounded-xl px-4 py-2 text-xs text-zinc-100 shadow-2xl transition-all duration-300 opacity-0 translate-y-2';
            toast.textContent = message;
            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.style.opacity = '1';
                toast.style.transform = 'translateY(0)';
            });
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-4px)';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        function updateWatchCount(count) {
            const el = document.getElementById('watchCountEl');
            if (el) {
                el.textContent = `${count} watching`;
            }
        }

        function showControls() {
            topOverlay.style.opacity = '1';
            bottomOverlay.style.opacity = '1';
            playerContainer.style.cursor = 'default';
            clearTimeout(hideTimeout);
            hideTimeout = setTimeout(() => {
                if (!video.paused) {
                    topOverlay.style.opacity = '0';
                    bottomOverlay.style.opacity = '0';
                    playerContainer.style.cursor = 'none';
                    document.getElementById('speedMenu').classList.add('hidden');
                    document.getElementById('qualityMenu').classList.add('hidden');
                }
            }, 3000);
        }

        playerContainer.addEventListener('mousemove', showControls);
        playerContainer.addEventListener('touchstart', showControls, { passive: true });

        function openInviteModal() {
            document.getElementById('inviteModal').classList.remove('hidden');
        }

        function closeInviteModal() {
            document.getElementById('inviteModal').classList.add('hidden');
            document.getElementById('copyNotification').classList.add('hidden');
        }

        function copyInviteLink() {
            const input = document.getElementById('roomUrlInput');
            input.select();
            document.execCommand('copy');
            const note = document.getElementById('copyNotification');
            note.classList.remove('hidden');
            setTimeout(() => { note.classList.add('hidden'); }, 2000);
        }

        // ---------------------------------------------------------------
        // WebSocket playback synchronization
        // ---------------------------------------------------------------

        function connectSync() {
            const scheme = location.protocol === 'https:' ? 'wss' : 'ws';
            ws = new WebSocket(`${scheme}://${location.host}/ws?roomId=${encodeURIComponent(ROOM_ID)}&userId=${encodeURIComponent(USER_ID)}`);

            ws.onopen = () => {
                wsConnected = true;
                reconnectAttempts = 0;
                // Cancel any pending reconnect timer so we never create a
                // second connection while this one is alive.
                clearTimeout(reconnectTimer);
                reconnectTimer = null;
                // The server sends a 'sync' message with the full playback
                // state immediately on connect (see setupClient), so the
                // client does NOT need to call resyncFromApi() here. Doing
                // both would race and double-apply play()/seek().
            };

            ws.onmessage = (event) => {
                let message;
                try {
                    message = JSON.parse(event.data);
                } catch {
                    return;
                }
                handleSyncMessage(message);
            };

            ws.onclose = (event) => {
                wsConnected = false;
                // 4001 = the server replaced this socket with a newer
                // connection from the same user (a reload or second tab).
                // The newest page owns the room socket — reconnecting here
                // would make two tabs fight over the connection.
                if (event.code === 4001) return;
                // Reconnect automatically with backoff (2s → 4s → 8s …
                // capped at 15s) so a server restart or network blip is
                // survived without hammering the server.
                clearTimeout(reconnectTimer);
                const delay = Math.min(2000 * 2 ** reconnectAttempts, 15000);
                reconnectAttempts += 1;
                reconnectTimer = setTimeout(connectSync, delay);
            };

            ws.onerror = () => {
                ws.close();
            };
        }

        // Poll the state API while the socket is down so playback changes
        // made by the host are still picked up during an outage.
        function startStatePolling() {
            clearInterval(statePollTimer);
            statePollTimer = setInterval(() => {
                if (!wsConnected) {
                    resyncFromApi();
                }
            }, 5000);
        }

        async function resyncFromApi() {
            try {
                const res = await fetch(`/room/${ROOM_ID}/state`);
                if (!res.ok) return;
                const data = await res.json();
                if (data.playback) {
                    applyPlaybackState(data.playback);
                }
                if (typeof data.watchCount === 'number') {
                    updateWatchCount(data.watchCount);
                }
            } catch {
                // Socket + API both down — the reconnect loop will handle it.
            }
        }

        function sendPlaybackEvent(event) {
            if (wsConnected && ws && ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify(event));
            }
        }

        function handleSyncMessage(message) {
            switch (message.type) {
                case 'sync':
                    applyPlaybackState(message.playback);
                    break;
                case 'play':
                    applyRemotePlay(message.timeline);
                    break;
                case 'pause':
                    applyRemotePause(message.timeline);
                    break;
                case 'seek':
                    applyRemoteSeek(message.timeline);
                    break;
                case 'quality':
                    document.getElementById('currentQuality').textContent = message.quality;
                    if (!IS_ADMIN) showToast(`Host set quality to ${message.quality}`);
                    break;
                case 'speed':
                    // Apply the new rate AND snap to the host's position at
                    // the moment of the change so viewers don't drift apart.
                    video.playbackRate = message.speed;
                    document.getElementById('speedBtn').textContent = `${message.speed}x`;
                    if (typeof message.timeline === 'number') {
                        applyRemoteSeek(message.timeline);
                    }
                    if (!IS_ADMIN) showToast(`Host set speed to ${message.speed}x`);
                    break;
                case 'drift':
                    applyDrift(message.timeline);
                    break;
                case 'users':
                    updateWatchCount(message.count);
                    break;
                case 'notification':
                    showToast(message.text);
                    break;
            }
        }

        // The host broadcasts its own events too (the server relays them back),
        // so every tab — including the host's — applies the same state. Viewer
        // tabs apply remote commands and ignore their own (disabled) controls.
        function applyRemotePlay(timeline) {
            pendingSeek = timeline;
            if (!video.paused) {
                video.currentTime = timeline;
                pendingSeek = null;
            }
            requestPlay();
            updatePlayButtons();
            triggerCenterAnimation();
        }

        function applyRemotePause(timeline) {
            // The room is paused now — any pending autoplay-block prompt is
            // stale and must not resume playback on the next click.
            autoplayBlocked = false;
            centerPlayIndicator.style.opacity = '0';
            pendingSeek = timeline;
            video.pause();
            if (video.currentTime !== timeline) {
                video.currentTime = timeline;
            }
            pendingSeek = null;
            updatePlayButtons();
            triggerCenterAnimation();
        }

        function applyRemoteSeek(timeline) {
            video.currentTime = timeline;
            pendingSeek = null;
        }

        function applyPlaybackState(playback) {
            const targetPaused = playback.paused;
            if (playback.quality) {
                document.getElementById('currentQuality').textContent = playback.quality;
            }
            // Restore the playback speed so viewers and a reloaded host both
            // match the persisted rate (was missing — speed reset to 1x on
            // every reload).
            if (typeof playback.speed === 'number' && playback.speed > 0) {
                video.playbackRate = playback.speed;
                document.getElementById('speedBtn').textContent = `${playback.speed}x`;
            }
            if (playback.timeline > 0 && video.readyState >= 1) {
                video.currentTime = video.duration
                    ? Math.min(playback.timeline, video.duration)
                    : playback.timeline;
            }
            if (targetPaused) {
                // Paused state — clear any stale autoplay-block prompt.
                autoplayBlocked = false;
                centerPlayIndicator.style.opacity = '0';
                video.pause();
            } else {
                // Defer until the video can actually play. On a fresh join or
                // reload the metadata is often still loading (readyState < 1),
                // so an immediate play() rejects. Once canplay fires, the
                // queued play happens.
                if (video.readyState >= 1) {
                    requestPlay();
                } else {
                    video.addEventListener('canplay', requestPlay, { once: true });
                }
            }
            updatePlayButtons();

            // If the metadata isn't loaded yet (fresh join or reload), the
            // seek above was skipped. Queue the state and re-apply it as soon
            // as the video becomes seekable so the timeline is still honored.
            if (playback.timeline > 0 && video.readyState < 1) {
                pendingSeek = playback.timeline;
            }
        }

        // When a seek/play arrives before the video can seek, retry once the
        // metadata is loaded so the timeline is applied.
        video.addEventListener('loadedmetadata', () => {
            if (pendingSeek !== null) {
                video.currentTime = pendingSeek;
                pendingSeek = null;
            }
        });

        // A freshly loaded video may still not be seekable immediately after
        // metadata loads, so the queued sync is re-applied once the first
        // frame is ready too. If playback is paused (the common reload case),
        // 'canplay' still fires and the timeline is honored.
        video.addEventListener('canplay', () => {
            if (pendingSeek !== null && video.readyState >= 1) {
                video.currentTime = pendingSeek;
                pendingSeek = null;
            }
        });

        // Lightweight drift correction. The host broadcasts its current
        // timeline every few seconds while playing; viewers nudge themselves
        // back only when they drift more than 1 second. No timeupdate-level
        // message spam.
        function applyDrift(timeline) {
            if (video.paused || !video.duration) return;
            const diff = timeline - video.currentTime;
            if (Math.abs(diff) > 1) {
                video.currentTime += Math.sign(diff) * Math.min(Math.abs(diff), 5);
            }
        }

        setInterval(() => {
            if (IS_ADMIN && wsConnected && !video.paused) {
                sendPlaybackEvent({ type: 'drift', timeline: video.currentTime });
            }
        }, 5000);

        startStatePolling();
        connectSync();
    </script>
    <% } %>
</body>
</html>