<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Party Watch — Discover & Watch Together</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        darkBg: '#09090b',
                        cardBg: '#121217',
                        accent: '#e50914',
                        accentHover: '#f40612',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-darkBg text-zinc-100 font-sans antialiased min-h-screen flex flex-col selection:bg-accent selection:text-white">

    <header class="sticky top-0 z-50 bg-darkBg/80 backdrop-blur-md border-b border-zinc-800/60">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <a href="/" class="flex items-center space-x-2.5 group">
                    <div class="w-9 h-9 rounded-xl bg-accent flex items-center justify-center shadow-lg shadow-accent/25 group-hover:scale-105 transition-transform">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <span class="text-lg font-bold tracking-tight text-white">Party Watch</span>
                </a>
            </div>
            
            <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-zinc-400">
                <a href="/" class="text-white hover:text-white transition-colors">Movies</a>
                <a href="#library" class="hover:text-white transition-colors">Browse Library</a>
                <a href="/room" class="hover:text-white transition-colors">Active Room Mock</a>
            </nav>

            <div class="flex items-center space-x-3">
                <div class="hidden sm:flex items-center space-x-2 bg-zinc-900/90 border border-zinc-800/80 rounded-full px-3 py-1.5 text-xs text-zinc-300">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="font-medium">3,421 watching</span>
                </div>
                <button onclick="openAddMovieModal()" class="px-4 py-2 bg-accent hover:bg-accentHover text-white text-xs font-semibold rounded-xl shadow-lg shadow-accent/20 transition-all flex items-center space-x-1.5 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>Add Movie</span>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow">
        <section class="relative pt-10 pb-8 md:pt-14 md:pb-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
            <div class="max-w-2xl">
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-3">
                    Watch together, <span class="text-zinc-400 font-normal">anywhere.</span>
                </h1>
                <p class="text-base sm:text-lg text-zinc-400 mb-8 font-normal leading-relaxed">
                    Pick a movie, start a synchronized watch room, and enjoy films with friends in real-time cinematic quality.
                </p>
            </div>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-zinc-800/80">
                <div class="relative flex-grow max-w-md">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-500">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </span>
                    <input 
                        type="search" 
                        id="searchInput" 
                        placeholder="Search movies..." 
                        autocomplete="off"
                        oninput="filterMovies()"
                        class="w-full bg-zinc-900/80 border border-zinc-800 rounded-xl pl-10 pr-4 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 focus:ring-1 focus:ring-zinc-600 transition-all shadow-inner"
                    >
                </div>

                <div class="flex items-center space-x-2 overflow-x-auto pb-2 sm:pb-0 scrollbar-none">
                    <button onclick="filterCategory('all')" id="btn-all" class="category-btn px-4 py-2 text-xs font-semibold rounded-lg bg-zinc-800 text-white hover:bg-zinc-700 transition-colors whitespace-nowrap shadow-sm">All Genres</button>
                    <button onclick="filterCategory('Sci-Fi')" id="btn-Sci-Fi" class="category-btn px-4 py-2 text-xs font-semibold rounded-lg bg-zinc-900/60 text-zinc-400 border border-zinc-800/80 hover:bg-zinc-800 hover:text-white transition-colors whitespace-nowrap">Sci-Fi</button>
                    <button onclick="filterCategory('Action')" id="btn-Action" class="category-btn px-4 py-2 text-xs font-semibold rounded-lg bg-zinc-900/60 text-zinc-400 border border-zinc-800/80 hover:bg-zinc-800 hover:text-white transition-colors whitespace-nowrap">Action</button>
                    <button onclick="filterCategory('Drama')" id="btn-Drama" class="category-btn px-4 py-2 text-xs font-semibold rounded-lg bg-zinc-900/60 text-zinc-400 border border-zinc-800/80 hover:bg-zinc-800 hover:text-white transition-colors whitespace-nowrap">Drama</button>
                    <button onclick="filterCategory('Animation')" id="btn-Animation" class="category-btn px-4 py-2 text-xs font-semibold rounded-lg bg-zinc-900/60 text-zinc-400 border border-zinc-800/80 hover:bg-zinc-800 hover:text-white transition-colors whitespace-nowrap">Animation</button>
                </div>
            </div>

            <% if (typeof movies === 'undefined' || movies.length === 0) { %>
                <div class="flex flex-col items-center justify-center py-20 px-4 text-center bg-cardBg/40 border border-zinc-800/60 rounded-2xl">
                    <div class="w-16 h-16 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 mb-4 shadow-lg">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"></path>
                        </svg>
                    </div>
                    <h2 class="text-xl font-bold text-white mb-2 tracking-tight">No movies yet</h2>
                    <p class="text-sm text-zinc-400 max-w-sm mb-6">Add a movie to your library and it will appear here for you and your friends to watch.</p>
                    <a href="/" class="px-5 py-2.5 bg-accent hover:bg-accentHover text-white text-xs font-semibold rounded-xl shadow-lg shadow-accent/20 transition-all">Refresh Library</a>
                </div>
            <% } else { %>
                <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="movieGrid">
                    <% for (const movie of movies) { %>
                        <article class="movie-card group bg-cardBg rounded-2xl overflow-hidden border border-zinc-800/80 hover:border-zinc-700 transition-all duration-300 flex flex-col shadow-xl shadow-black/40" data-title="<%= movie.title.toLowerCase() %>" data-genre="<%= movie.genre || 'Sci-Fi' %>">
                            <div class="relative aspect-[16/9] sm:aspect-[4/3] overflow-hidden bg-zinc-900">
                                <img
                                    src="/movie/<%= movie.id %>/thumbnail"
                                    alt="<%= movie.title %>"
                                    loading="lazy"
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                    onerror="this.replaceWith(Object.assign(document.createElement('div'), { className: 'w-full h-full flex items-center justify-center bg-zinc-900 text-zinc-500 font-bold text-sm', textContent: '<%= movie.title %>' }))"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-cardBg via-transparent to-transparent opacity-80"></div>
                                <span class="absolute top-3 right-3 px-2.5 py-1 text-[11px] font-semibold tracking-wide uppercase bg-black/70 backdrop-blur-md text-zinc-300 rounded-md border border-white/10 shadow-sm"><%= movie.genre || 'Sci-Fi' %></span>
                            </div>
                            <div class="p-5 flex flex-col flex-grow justify-between">
                                <div>
                                    <div class="flex items-center justify-between text-xs text-zinc-400 mb-1.5 font-medium">
                                        <span><%= movie.year %></span>
                                        <span><%= movie.duration %></span>
                                    </div>
                                    <h3 class="text-base font-bold text-white tracking-tight group-hover:text-accent transition-colors line-clamp-1"><%= movie.title %></h3>
                                </div>
                                <div class="mt-5 pt-4 border-t border-zinc-800/60 flex items-center justify-between">
                                    <span class="text-xs text-zinc-500 font-medium">Synced Watch</span>
                                    <button type="button" onclick="openCreateRoomModal('<%= movie.id %>', '<%= movie.title.replace(/'/g, "\\'") %>')" class="px-3.5 py-2 bg-accent hover:bg-accentHover text-white text-xs font-semibold rounded-xl shadow-md shadow-accent/20 transition-all flex items-center space-x-1.5 cursor-pointer">
                                        <span>Create Room</span>
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                                    </button>
                                </div>
                            </div>
                        </article>
                    <% } %>
                </section>
            <% } %>
        </section>
    </main>

    <footer class="border-t border-zinc-800/60 bg-darkBg py-6 mt-12 text-center text-xs text-zinc-500">
        <p>&copy; 2026 Party Watch. Cinematic watch rooms for friends.</p>
    </footer>

    <!-- Create Room Modal -->
    <div id="createRoomModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-cardBg border border-zinc-800/80 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl shadow-black relative">
            <button type="button" onclick="closeCreateRoomModal()" class="absolute top-6 right-6 text-zinc-400 hover:text-white cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <div class="w-12 h-12 rounded-2xl bg-accent/20 border border-accent/30 text-accent flex items-center justify-center mb-4 shadow-lg shadow-accent/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-1 tracking-tight">Create Screening Room</h3>
            <p id="modalMovieTitle" class="text-sm text-zinc-400 mb-6 font-medium">Configure settings for your watch room.</p>
            
            <form id="createRoomForm" action="/rooms" method="POST" onsubmit="return validateRoomForm(event)" class="space-y-4">
                <input type="hidden" id="modalMovieId" name="movieId" value="" />
                
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-2">Room Type</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="cursor-pointer">
                            <input type="radio" name="roomType" id="typePublic" value="public" checked onchange="toggleRoomType('public')" class="peer sr-only" />
                            <div class="px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-center text-xs font-semibold text-zinc-400 peer-checked:bg-zinc-800 peer-checked:border-accent peer-checked:text-white transition-all shadow-sm">
                                Public Room
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="roomType" id="typePrivate" value="private" onchange="toggleRoomType('private')" class="peer sr-only" />
                            <div class="px-4 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-center text-xs font-semibold text-zinc-400 peer-checked:bg-zinc-800 peer-checked:border-accent peer-checked:text-white transition-all shadow-sm">
                                Private Room
                            </div>
                        </label>
                    </div>
                </div>

                <div id="passwordSection" class="hidden">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1.5">Room Password (Min 4 chars)</label>
                    <input 
                        type="password" 
                        id="roomPasswordInput" 
                        name="password" 
                        placeholder="Enter password (e.g. secret123)" 
                        oninput="checkPasswordCondition()"
                        class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all" 
                    />
                    <p id="passwordError" class="text-xs text-accent mt-1 hidden">Password must be at least 4 characters long.</p>
                </div>

                <div class="pt-4 flex items-center justify-end space-x-3">
                    <button type="button" onclick="closeCreateRoomModal()" class="px-5 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-semibold rounded-xl transition-all cursor-pointer">Cancel</button>
                    <button type="submit" class="px-5 py-2.5 bg-accent hover:bg-accentHover text-white text-xs font-semibold rounded-xl shadow-lg shadow-accent/20 transition-all cursor-pointer">Launch Room</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add Movie Modal -->
    <div id="addMovieModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-cardBg border border-zinc-800/80 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl shadow-black relative">
            <button onclick="closeAddMovieModal()" class="absolute top-6 right-6 text-zinc-400 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <div class="w-12 h-12 rounded-2xl bg-accent/20 border border-accent/30 text-accent flex items-center justify-center mb-4 shadow-lg shadow-accent/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2 tracking-tight">Add Movie to Library</h3>
            <p class="text-sm text-zinc-400 mb-6">Upload a video file and thumbnail to start a watch room with friends.</p>
            
            <form action="/movies" method="POST" enctype="multipart/form-data" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1.5">Movie Title</label>
                    <input type="text" name="title" required placeholder="e.g. Interstellar Odyssey" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 focus:ring-1 focus:ring-zinc-600 transition-all" />
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1.5">Genre</label>
                        <select name="genre" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-zinc-100 focus:outline-none focus:border-zinc-600 focus:ring-1 focus:ring-zinc-600 transition-all">
                            <option value="Sci-Fi">Sci-Fi</option>
                            <option value="Action">Action</option>
                            <option value="Drama">Drama</option>
                            <option value="Animation">Animation</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1.5">Release Year</label>
                        <input type="number" name="year" value="2026" required class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-zinc-100 focus:outline-none focus:border-zinc-600 focus:ring-1 focus:ring-zinc-600 transition-all" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1.5">Video File (.mp4/.webm)</label>
                        <input type="file" name="video" accept="video/*" required class="w-full bg-zinc-900 border border-zinc-800 rounded-xl p-2 text-xs text-zinc-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-accent file:text-white hover:file:bg-accentHover cursor-pointer" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1.5">Thumbnail Image (.jpg/.png)</label>
                        <input type="file" name="thumbnail" accept="image/*" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl p-2 text-xs text-zinc-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-zinc-800 file:text-zinc-200 hover:file:bg-zinc-700 cursor-pointer" />
                    </div>
                </div>

                <div class="pt-4 flex items-center justify-end space-x-3">
                    <button type="button" onclick="closeAddMovieModal()" class="px-5 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-semibold rounded-xl transition-all">Cancel</button>
                    <button type="submit" class="px-5 py-2.5 bg-accent hover:bg-accentHover text-white text-xs font-semibold rounded-xl shadow-lg shadow-accent/20 transition-all">Upload Movie</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const searchInput = document.getElementById('searchInput');
        const movieGrid = document.getElementById('movieGrid');
        let currentCategory = 'all';

        function openAddMovieModal() {
            document.getElementById('addMovieModal').classList.remove('hidden');
        }

        function closeAddMovieModal() {
            document.getElementById('addMovieModal').classList.add('hidden');
        }

        function openCreateRoomModal(movieId, movieTitle) {
            document.getElementById('modalMovieId').value = movieId;
            document.getElementById('modalMovieTitle').textContent = `Movie: ${movieTitle}`;
            document.getElementById('typePublic').checked = true;
            document.getElementById('typePrivate').checked = false;
            toggleRoomType('public');
            document.getElementById('roomPasswordInput').value = '';
            document.getElementById('passwordError').classList.add('hidden');
            document.getElementById('createRoomModal').classList.remove('hidden');
        }

        function closeCreateRoomModal() {
            document.getElementById('createRoomModal').classList.add('hidden');
        }

        function toggleRoomType(type) {
            const passwordSection = document.getElementById('passwordSection');
            const passwordInput = document.getElementById('roomPasswordInput');
            const passwordError = document.getElementById('passwordError');
            
            passwordError.classList.add('hidden');
            if (type === 'private') {
                passwordSection.classList.remove('hidden');
                passwordInput.setAttribute('required', 'required');
            } else {
                passwordSection.classList.add('hidden');
                passwordInput.removeAttribute('required');
                passwordInput.value = '';
            }
        }

        // Single condition enforcement: if password has content, force room type to private
        function checkPasswordCondition() {
            const passwordInput = document.getElementById('roomPasswordInput');
            const typePrivate = document.getElementById('typePrivate');
            const typePublic = document.getElementById('typePublic');
            const passwordSection = document.getElementById('passwordSection');

            if (passwordInput.value.trim().length > 0) {
                passwordSection.classList.remove('hidden');
                typePrivate.checked = true;
                typePublic.checked = false;
            }
        }

        function validateRoomForm(event) {
            event.preventDefault();
            const passwordInput = document.getElementById('roomPasswordInput');
            const passwordError = document.getElementById('passwordError');
            const movieId = document.getElementById('modalMovieId').value;
            const typePrivate = document.getElementById('typePrivate');
            const typePublic = document.getElementById('typePublic');
            const val = passwordInput.value.trim();

            // Enforce condition: if there is any password text, validate its length and force private state
            if (val.length > 0) {
                typePrivate.checked = true;
                typePublic.checked = false;
                if (val.length < 4) {
                    passwordError.classList.remove('hidden');
                    passwordInput.focus();
                    return false;
                }
            } else {
                passwordInput.value = '';
            }

            const payload = {
                movieId: movieId,
                visibility: typePrivate.checked ? 'private' : 'public'
            };
            if (val.length > 0) {
                payload.password = val;
            }

            fetch('/rooms', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            }).then(response => {
                if (response.ok) {
                    window.location.href = response.url;
                } else {
                    alert('Error creating room. Please check your settings.');
                }
            }).catch(err => {
                console.error(err);
                alert('An error occurred.');
            });

            return false;
        }

        function filterCategory(category) {
            currentCategory = category;
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.className = "category-btn px-4 py-2 text-xs font-semibold rounded-lg bg-zinc-900/60 text-zinc-400 border border-zinc-800/80 hover:bg-zinc-800 hover:text-white transition-colors whitespace-nowrap";
            });
            const activeBtn = document.getElementById(`btn-${category}`);
            if (activeBtn) {
                activeBtn.className = "category-btn px-4 py-2 text-xs font-semibold rounded-lg bg-zinc-800 text-white hover:bg-zinc-700 transition-colors whitespace-nowrap shadow-sm";
            }
            filterMovies();
        }

        function filterMovies() {
            if (!movieGrid) return;
            const query = searchInput ? searchInput.value.toLowerCase() : '';
            const cards = movieGrid.querySelectorAll('.movie-card');
            cards.forEach(card => {
                const title = card.getAttribute('data-title') || '';
                const genre = card.getAttribute('data-genre') || '';
                const matchesSearch = title.includes(query);
                const matchesCategory = (currentCategory === 'all' || genre === currentCategory);
                if (matchesSearch && matchesCategory) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>